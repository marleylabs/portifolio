# URL pública do site (canonical, Open Graph, sitemap, RSS e links dos e-mails)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.dev

# Upstash Redis — curtidas e limites anti-spam.
# OBRIGATÓRIO em produção também para o contato e a newsletter: sem ele (ou sem o
# VISITOR_SALT abaixo), os dois formulários ficam indisponíveis de propósito, para não
# aceitar envios sem limite.
# (na Vercel, a integração Upstash cria KV_REST_API_URL e KV_REST_API_TOKEN, que também funcionam)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Texto aleatório e secreto para o hash anônimo dos visitantes (ex.: `openssl rand -hex 32`)
VISITOR_SALT=

# Resend — formulário de contato e newsletter
RESEND_API_KEY=
# Remetente num domínio verificado no Resend
RESEND_FROM="Anderson Marley <contato@seu-dominio.dev>"
# Quem recebe as mensagens do formulário de contato
CONTACT_TO_EMAIL=
# (opcional) segmento do Resend onde entram os inscritos confirmados
RESEND_SEGMENT_ID=
# Texto aleatório e secreto que assina os links de confirmação da newsletter
NEWSLETTER_SECRET=

# Opcional: armazenamento em memória num build de produção (testes locais; não persiste)
# LIKES_STORE=memory
